          "punctuation.list_marker": { "color": "#70766B" },
          "punctuation.special": { "color": "#70766B" },
          "tag": { "color": "#536B4F" },
          "tag.doctype": { "color": "#536B4F" },
          "attribute": { "color": "#7E9273" },
          "selector": { "color": "#7E9273" },
          "preproc": { "color": "#B69A64" },
          "label": { "color": "#7E9273" },
          "lifetime": { "color": "#7E9273" },
