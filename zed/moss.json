          "boolean": { "color": "#B69A64" },
          "type": { "color": "#D7D9D2" },
          "type.builtin": { "color": "#D7D9D2" },
          "enum": { "color": "#D7D9D2" },
          "variant": { "color": "#B69A64" },
          "namespace": { "color": "#D7D9D2" },
          "operator": { "color": "#536B4F" },
