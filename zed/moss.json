          "comment.doc": { "color": "#70766B", "font_style": "italic" },
          "embedded": { "color": "#D7D9D2" },
          "primary": { "color": "#D7D9D2" },
          "title": { "color": "#D7D9D2", "font_weight": 700 },
          "emphasis": { "color": "#D7D9D2", "font_style": "italic" },
          "emphasis.strong": { "color": "#D7D9D2", "font_weight": 700 },
          "text.literal": { "color": "#9A9968" },
          "link_text": { "color": "#7E9273" },
          "link_uri": { "color": "#70766B" },
          "hint": { "color": "#70766B" },
          "predictive": { "color": "#70766B", "font_style": "italic" }
