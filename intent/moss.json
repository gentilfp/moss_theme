{
  "name": "MOSS",
  "type": "dark",
  "colors": {
    "editor.background": "#0D0F0C",
    "editor.foreground": "#D7D9D2",
    "sideBar.background": "#141713",
    "sideBar.foreground": "#D7D9D2",
    "sideBar.border": "#272C24",
    "editorWidget.background": "#1B1F1A",
    "editorWidget.foreground": "#D7D9D2",
    "dropdown.background": "#1B1F1A",
    "dropdown.foreground": "#D7D9D2",
    "focusBorder": "#7E9273",
    "input.background": "#141713",
    "input.border": "#272C24",
    "panel.border": "#272C24",
    "editorGroup.border": "#272C24",
    "button.background": "#7E9273",
    "button.foreground": "#0D0F0C",
    "list.activeSelectionBackground": "#2A3527",
    "list.activeSelectionForeground": "#D7D9D2",
    "tab.inactiveBackground": "#141713",
    "descriptionForeground": "#70766B",
    "errorForeground": "#C06B63",
    "inputValidation.errorBackground": "#A75D57",
    "editorInfo.foreground": "#7E9273",
    "editorWarning.foreground": "#B69A64",
    "testing.iconPassed": "#7E9273",
    "gitDecoration.addedResourceForeground": "#7E9273",
    "terminal.background": "#0D0F0C",
    "terminal.foreground": "#D7D9D2",
    "terminal.selectionBackground": "#2A3527",
    "terminal.selectionForeground": "#D7D9D2",
    "terminalCursor.foreground": "#7E9273",
    "terminalCursor.background": "#0D0F0C",
    "terminal.ansiBlack": "#0D0F0C",
    "terminal.ansiRed": "#A75D57",
    "terminal.ansiGreen": "#7E9273",
    "terminal.ansiYellow": "#B69A64",
    "terminal.ansiBlue": "#5D7B81",
    "terminal.ansiMagenta": "#8F6C80",
    "terminal.ansiCyan": "#9A9968",
    "terminal.ansiWhite": "#D7D9D2",
    "terminal.ansiBrightBlack": "#70766B",
    "terminal.ansiBrightRed": "#C06B63",
    "terminal.ansiBrightGreen": "#92A389",
    "terminal.ansiBrightYellow": "#C7A46B",
    "terminal.ansiBrightBlue": "#6C8D94",
    "terminal.ansiBrightMagenta": "#A08193",
    "terminal.ansiBrightCyan": "#AAA97F",
    "terminal.ansiBrightWhite": "#F0F0EE"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#70766B", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation", "comment.block.javadoc"], "settings": { "foreground": "#70766B", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#7E9273" } },
    { "scope": ["keyword.operator", "punctuation.separator.key-value"], "settings": { "foreground": "#536B4F" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.definition.tag"], "settings": { "foreground": "#70766B" } },
    { "scope": ["string", "string.quoted", "constant.character"], "settings": { "foreground": "#9A9968" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#C7A46B" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#B69A64" } },
    { "scope": ["constant", "constant.numeric", "constant.language", "variable.language"], "settings": { "foreground": "#B69A64" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#D7D9D2" } },
    { "scope": ["variable", "variable.other", "variable.other.property", "meta.property-name"], "settings": { "foreground": "#D7D9D2" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#D7D9D2", "fontStyle": "italic" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.namespace"], "settings": { "foreground": "#D7D9D2" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#536B4F" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#7E9273" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator", "storage.type.annotation"], "settings": { "foreground": "#B69A64" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#C06B63" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7E9273", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#7E9273" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#B69A64" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#A75D57" } }
  ]
}
